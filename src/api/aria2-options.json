{
  "allOptions": {
    "gid": {
      "type": "string",
      "readonly": true,
      "required": true
    },
    "dir": {
      "type": "string",
      "required": true,
      "lazySaveTimeout": 1500,
      "showHistory": true
    },
    "log": {
      "type": "string",
      "lazySaveTimeout": 2000,
      "required": true
    },
    "max-concurrent-downloads": {
      "type": "integer",
      "defaultValue": "5",
      "required": true,
      "min": 1
    },
    "check-integrity": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "continue": {
      "type": "boolean",
      "required": true
    },
    "all-proxy": {
      "type": "string",
      "lazySaveTimeout": 1000,
      "showHistory": true
    },
    "all-proxy-user": {
      "type": "string"
    },
    "all-proxy-passwd": {
      "type": "string"
    },
    "checksum": {
      "type": "string",
      "required": true,
      "pattern": "^(md5|sha-(1|224|256|384|512))=[a-zA-Z0-9]+$"
    },
    "connect-timeout": {
      "type": "integer",
      "suffix": "Seconds",
      "defaultValue": "60",
      "required": true,
      "min": 1,
      "max": 600
    },
    "dry-run": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "lowest-speed-limit": {
      "type": "string",
      "suffix": "Bytes",
      "defaultValue": "0",
      "required": true,
      "pattern": "^(0|[1-9]\\d*(K|k|M|m)?)$"
    },
    "max-connection-per-server": {
      "type": "integer",
      "defaultValue": "16",
      "required": true,
      "min": 1,
      "max": 32
    },
    "max-file-not-found": {
      "type": "integer",
      "defaultValue": "0",
      "required": true,
      "min": 0
    },
    "max-tries": {
      "type": "integer",
      "defaultValue": "5",
      "required": true,
      "min": 0
    },
    "min-split-size": {
      "type": "string",
      "suffix": "Bytes",
      "defaultValue": "20M",
      "required": true,
      "pattern": "^(0|[1-9]\\d*(K|k|M|m)?)$"
    },
    "netrc-path": {
      "type": "string",
      "readonly": true,
      "defaultValue": "$(HOME)/.netrc"
    },
    "no-netrc": {
      "type": "boolean",
      "required": true
    },
    "no-proxy": {
      "type": "text",
      "separator": ",",
      "showCount": true
    },
    "out": {
      "type": "string",
      "pattern": "^[^\\/:*?\"<>|]+$"
    },
    "remote-time": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "retry-wait": {
      "type": "integer",
      "suffix": "Seconds",
      "defaultValue": "0",
      "required": true,
      "min": 0,
      "max": 600
    },
    "split": {
      "type": "integer",
      "defaultValue": "5",
      "required": true,
      "min": 1
    },
    "timeout": {
      "type": "integer",
      "suffix": "Seconds",
      "defaultValue": "60",
      "required": true,
      "min": 1,
      "max": 600
    },
    "check-certificate": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "true"
    },
    "http-accept-gzip": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "http-no-cache": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "http-user": {
      "type": "string"
    },
    "http-passwd": {
      "type": "string"
    },
    "http-proxy": {
      "type": "string"
    },
    "http-proxy-user": {
      "type": "string"
    },
    "http-proxy-passwd": {
      "type": "string"
    },
    "https-proxy": {
      "type": "string"
    },
    "https-proxy-user": {
      "type": "string"
    },
    "https-proxy-passwd": {
      "type": "string"
    },
    "referer": {
      "type": "string"
    },
    "enable-http-keep-alive": {
      "type": "boolean",
      "defaultValue": "true",
      "required": true
    },
    "header": {
      "type": "text",
      "separator": "\n",
      "overrideMode": "append",
      "submitFormat": "array",
      "showCount": true,
      "trimCount": true
    },
    "save-cookies": {
      "type": "string"
    },
    "user-agent": {
      "type": "string",
      "defaultValue": "aria2/$VERSION"
    },
    "show-files": {
      "type": "boolean",
      "readonly": true
    },
    "bt-enable-lpd": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "bt-exclude-tracker": {
      "type": "text",
      "separator": ",",
      "showCount": true
    },
    "bt-external-ip": {
      "type": "string"
    },
    "bt-max-peers": {
      "type": "integer",
      "defaultValue": "55",
      "required": true,
      "min": 0
    },
    "bt-seed-unverified": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "bt-tracker": {
      "type": "text",
      "separator": ",",
      "showCount": true
    },
    "enable-dht": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "true"
    },
    "enable-peer-exchange": {
      "type": "boolean",
      "defaultValue": "true",
      "required": true
    },
    "follow-torrent": {
      "type": "option",
      "options": [
        "true",
        "false",
        "mem"
      ],
      "defaultValue": "true",
      "required": true
    },
    "listen-port": {
      "type": "integer",
      "readonly": true,
      "defaultValue": "6881-6999"
    },
    "max-overall-upload-limit": {
      "type": "string",
      "min": 0,
      "rangeMax": 50,
      "suffix": "Bytes",
      "defaultValue": "0",
      "icons": [
        "icon-upload",
        "fa-arrow-up"
      ],
      "required": true,
      "pattern": "^(0|[1-9]\\d*(K|k|M|m)?)$"
    },
    "max-upload-limit": {
      "type": "string",
      "suffix": "Bytes",
      "defaultValue": "0",
      "required": true,
      "pattern": "^(0|[1-9]\\d*(K|k|M|m)?)$"
    },
    "seed-ratio": {
      "type": "float",
      "defaultValue": "1.0",
      "required": true,
      "min": 0
    },
    "seed-time": {
      "type": "float",
      "suffix": "Minutes",
      "required": true,
      "min": 0
    },
    "follow-metalink": {
      "type": "option",
      "options": [
        "true",
        "false",
        "mem"
      ],
      "defaultValue": "true",
      "required": true
    },
    "enable-rpc": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "false"
    },
    "pause-metadata": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "rpc-allow-origin-all": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "false"
    },
    "rpc-listen-all": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "false"
    },
    "rpc-listen-port": {
      "type": "integer",
      "readonly": true,
      "defaultValue": "6800"
    },
    "rpc-max-request-size": {
      "type": "string",
      "suffix": "Bytes",
      "readonly": true,
      "defaultValue": "2M"
    },
    "rpc-save-upload-metadata": {
      "type": "boolean",
      "defaultValue": "true",
      "required": true
    },
    "allow-overwrite": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "auto-file-renaming": {
      "type": "boolean",
      "defaultValue": "true",
      "required": true
    },
    "conf-path": {
      "type": "string",
      "readonly": true,
      "defaultValue": "$HOME/.aria2/aria2.conf"
    },
    "console-log-level": {
      "type": "option",
      "options": [
        "debug",
        "info",
        "notice",
        "warn",
        "error"
      ],
      "readonly": true,
      "defaultValue": "notice"
    },
    "daemon": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "false"
    },
    "disable-ipv6": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "false"
    },
    "download-result": {
      "type": "option",
      "options": [
        "default",
        "full",
        "hide"
      ],
      "defaultValue": "default",
      "required": true
    },
    "enable-color": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "true"
    },
    "file-allocation": {
      "type": "option",
      "options": [
        "none",
        "prealloc",
        "trunc",
        "falloc"
      ],
      "defaultValue": "prealloc",
      "required": true
    },
    "force-save": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "save-not-found": {
      "since": "1.27.0",
      "type": "boolean",
      "defaultValue": "true",
      "required": true
    },
    "hash-check-only": {
      "type": "boolean",
      "defaultValue": "false",
      "required": true
    },
    "keep-unfinished-download-result": {
      "type": "boolean",
      "defaultValue": "true",
      "required": true
    },
    "max-download-result": {
      "type": "integer",
      "defaultValue": "1000",
      "required": true,
      "min": 0
    },
    "min-tls-version": {
      "type": "option",
      "options": [
        "SSLv3",
        "TLSv1",
        "TLSv1.1",
        "TLSv1.2"
      ],
      "readonly": true,
      "defaultValue": "TLSv1"
    },
    "log-level": {
      "type": "option",
      "options": [
        "debug",
        "info",
        "notice",
        "warn",
        "error"
      ],
      "defaultValue": "debug",
      "required": true
    },
    "show-console-readout": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "true"
    },
    "summary-interval": {
      "type": "integer",
      "suffix": "Seconds",
      "readonly": true,
      "defaultValue": "60"
    },
    "max-overall-download-limit": {
      "type": "string",
      "suffix": "Bytes",
      "defaultValue": "0",
      "min": 0,
      "rangeMax": 100,
      "icons": [
        "icon-download",
        "fa-arrow-down"
      ],
      "required": true,
      "pattern": "^(0|[1-9]\\d*(K|k|M|m)?)$"
    },
    "max-download-limit": {
      "type": "string",
      "suffix": "Bytes",
      "defaultValue": "0",
      "required": true,
      "pattern": "^(0|[1-9]\\d*(K|k|M|m)?)$"
    },
    "no-conf": {
      "type": "boolean",
      "readonly": true
    },
    "quiet": {
      "type": "boolean",
      "readonly": true,
      "defaultValue": "false"
    },
    "remove-control-file": {
      "type": "boolean",
      "required": true
    },
    "save-session": {
      "readonly": true,
      "type": "string"
    },
    "save-session-interval": {
      "type": "integer",
      "suffix": "Seconds",
      "readonly": true,
      "defaultValue": "0"
    },
    "stop": {
      "type": "integer",
      "suffix": "Seconds",
      "readonly": true,
      "defaultValue": "0"
    },
    "input-file": {
      "type": "string",
      "lazySaveTimeout": 1000
    },
    "ca-certificate": {
      "type": "string"
    },
    "certificate": {
      "type": "string"
    },
    "private-key": {
      "type": "string"
    },
    "dns-over-https": {
      "type": "string"
    },
    "interface": {
      "type": "string"
    },
    "sftp-user": {
      "type": "string"
    },
    "sftp-passwd": {
      "type": "string"
    },
    "ssh-host-key-sha256": {
      "type": "string"
    },
    "filename-hint": {
      "type": "string",
      "lazySaveTimeout": 1000
    },
    "filename-hint-source": {
      "type": "option",
      "options": [
        "suggested",
        "browser",
        "title"
      ],
      "defaultValue": "suggested"
    },
    "incomplete-suffix": {
      "type": "string",
      "defaultValue": ".part"
    },
    "auto-file-renaming-style": {
      "type": "option",
      "options": [
        "dot",
        "parentheses"
      ],
      "defaultValue": "dot"
    },
    "index-out": {
      "type": "string"
    },
    "torrent-file": {
      "type": "string"
    },
    "select-file": {
      "type": "string"
    },
    "bt-port-mapping": {
      "type": "boolean",
      "defaultValue": "true"
    },
    "bt-encryption": {
      "type": "option",
      "options": [
        "preferred",
        "required",
        "disabled"
      ],
      "defaultValue": "preferred"
    },
    "bt-transport": {
      "type": "option",
      "options": [
        "both",
        "tcp",
        "utp"
      ],
      "defaultValue": "both"
    },
    "bt-max-connections": {
      "type": "integer",
      "defaultValue": "55",
      "min": 0
    },
    "bt-max-uploads": {
      "type": "integer",
      "defaultValue": "0",
      "min": 0
    },
    "bt-max-uploads-per-torrent": {
      "type": "integer",
      "defaultValue": "4",
      "min": 0
    },
    "bt-super-seeding": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "bt-first-last-piece-first": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "bt-file-priority": {
      "type": "string"
    },
    "force-sequential": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "detach-share-only": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "bt-external-port": {
      "type": "integer",
      "defaultValue": "0",
      "min": 0,
      "max": 65535
    },
    "bt-interface": {
      "type": "string"
    },
    "bt-proxy": {
      "type": "string"
    },
    "bt-anonymous-mode": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "bt-user-agent": {
      "type": "string"
    },
    "bt-peer-id-prefix": {
      "type": "string"
    },
    "bt-peer-blocklist": {
      "type": "string"
    },
    "bt-blocklist-scope": {
      "type": "option",
      "options": [
        "all",
        "peers",
        "trackers"
      ],
      "defaultValue": "all"
    },
    "bt-rate-limit-overhead": {
      "type": "boolean",
      "defaultValue": "true"
    },
    "bt-dht-bootstrap-nodes": {
      "type": "text",
      "separator": ","
    },
    "metalink-file": {
      "type": "string"
    },
    "ed2k-server": {
      "type": "text",
      "separator": ","
    },
    "ed2k-server-list": {
      "type": "string"
    },
    "ed2k-node-list": {
      "type": "string"
    },
    "ed2k-listen-port": {
      "type": "integer",
      "defaultValue": "4662",
      "min": 0,
      "max": 65535
    },
    "ed2k-udp-listen-port": {
      "type": "integer",
      "defaultValue": "4672",
      "min": 0,
      "max": 65535
    },
    "ed2k-port-mapping": {
      "type": "boolean",
      "defaultValue": "true"
    },
    "ed2k-upload-slots": {
      "type": "integer",
      "defaultValue": "4",
      "min": 1
    },
    "ed2k-max-connections": {
      "type": "integer",
      "defaultValue": "100",
      "min": 1
    },
    "ed2k-preview-priority": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "media": {
      "type": "option",
      "options": [
        "auto",
        "file",
        "hls",
        "dash",
        "collection"
      ],
      "defaultValue": "auto"
    },
    "media-format": {
      "type": "option",
      "options": [
        "mp4",
        "mkv",
        "vtt"
      ],
      "defaultValue": "mp4"
    },
    "media-video": {
      "type": "string",
      "defaultValue": "best"
    },
    "media-audio": {
      "type": "string",
      "defaultValue": "best"
    },
    "media-subtitles": {
      "type": "string",
      "defaultValue": "all"
    },
    "media-pause-after-probe": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "media-record-time": {
      "type": "string"
    },
    "media-start-time": {
      "type": "string"
    },
    "media-end-time": {
      "type": "string"
    },
    "media-request-contexts": {
      "type": "integer",
      "defaultValue": "4",
      "min": 1
    },
    "media-input": {
      "type": "string"
    },
    "rpc-secret": {
      "type": "string"
    },
    "pause": {
      "type": "boolean",
      "defaultValue": "false"
    },
    "state-dir": {
      "type": "string"
    },
    "state-save-interval": {
      "type": "integer",
      "suffix": "Seconds",
      "defaultValue": "30",
      "min": 0
    },
    "stop-with-process": {
      "type": "integer",
      "min": 1
    },
    "log-max-size": {
      "type": "string",
      "defaultValue": "10M"
    },
    "log-max-files": {
      "type": "integer",
      "defaultValue": "5",
      "min": 1
    },
    "on-download-start": {
      "type": "string"
    },
    "on-download-pause": {
      "type": "string"
    },
    "on-download-stop": {
      "type": "string"
    },
    "on-download-complete": {
      "type": "string"
    },
    "on-download-error": {
      "type": "string"
    },
    "on-bt-download-complete": {
      "type": "string"
    },
    "load-cookies": {
      "type": "string"
    },
    "version": {
      "type": "boolean",
      "readonly": true
    },
    "help": {
      "type": "boolean",
      "readonly": true
    }
  },
